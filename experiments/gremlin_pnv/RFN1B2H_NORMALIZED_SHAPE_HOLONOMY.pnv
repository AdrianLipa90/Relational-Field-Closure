PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# CONTRACT RFN1B2H_NORMALIZED_SHAPE_HOLONOMY_V0_1
# PNCS_HEAD 695223eff9373554c4c2aff1aca9c3e1e7dfecd4
# PURPOSE normalized-shape and extensive-scale holonomy audit

OP Q1 SOURCE rfc.q1
OP Q2 SOURCE rfc.q2

OP P1 TRANSFORM Q1 NORMALIZE
OP P2 TRANSFORM Q2 NORMALIZE
OP SHAPE_SAME IDENTITY P1 P2
ASSERT SHAPE_SAME

OP Q1_RT TRANSFORM P1 RESTORE_Q1_TOTAL
OP Q2_RT TRANSFORM P2 RESTORE_Q2_TOTAL
OP Q1_CLOSED IDENTITY Q1 Q1_RT
OP Q2_CLOSED IDENTITY Q2 Q2_RT
ASSERT Q1_CLOSED
ASSERT Q2_CLOSED

OP Q1_UNIT TRANSFORM P1 RESTORE_UNIT_TOTAL
OP Q2_UNIT TRANSFORM P2 RESTORE_UNIT_TOTAL
OP Q1_UNIT_DEFECT DIFFERENCE Q1 Q1_UNIT
OP Q2_UNIT_DEFECT DIFFERENCE Q2 Q2_UNIT

OP RHO_EPS1 TRANSFORM Q1 RHO_EPS1
OP RHO_EPS3 TRANSFORM Q1 RHO_EPS3
OP PRHO_EPS1 TRANSFORM RHO_EPS1 NORMALIZE
OP PRHO_EPS3 TRANSFORM RHO_EPS3 NORMALIZE
OP EPS_SHAPE_SAME IDENTITY PRHO_EPS1 PRHO_EPS3
ASSERT EPS_SHAPE_SAME
OP EPS_SCALE_DEFECT DIFFERENCE RHO_EPS1 RHO_EPS3

OP AUDIT COMPOSITION SHAPE_SAME Q1_CLOSED Q2_CLOSED Q1_UNIT_DEFECT Q2_UNIT_DEFECT EPS_SHAPE_SAME EPS_SCALE_DEFECT
OP RFC.RETURN RETURN AUDIT

EMIT SHAPE_SAME
EMIT Q1_CLOSED
EMIT Q2_CLOSED
EMIT Q1_UNIT_DEFECT
EMIT Q2_UNIT_DEFECT
EMIT EPS_SHAPE_SAME
EMIT EPS_SCALE_DEFECT
EMIT RFC.RETURN
